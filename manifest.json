{
  "manifest_version": 3,
  "name": "VK Teams Custom Reactions",
  "version": "1.1.0",
  "description": "Add custom emoji reactions to VK Teams messages",
  "permissions": [
    "activeTab",
    "tabs",
    "cookies",
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://teams.your-organization.com/*",
    "https://*.teams.your-organization.com/*",
    "https://webim.teams.your-organization.com/*",
    "https://u.teams.your-organization.com/*",
    "https://ub.teams.your-organization.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://app.workspace.vk.ru/*",
    "https://workspace.vk.ru/*",
    "https://*.workspace.vk.ru/*",
    "https://myteam.mail.ru/*",
    "https://*.myteam.mail.ru/*",
    "https://*.bizml.ru/*",
    "https://generativelanguage.googleapis.com/*",
    "http://localhost:11434/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "VK Teams Custom Reactions Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.your-organization.com/*",
        "https://*.teams.your-organization.com/*",
        "https://webim.teams.your-organization.com/*",
        "https://app.workspace.vk.ru/*",
        "https://workspace.vk.ru/*",
        "https://*.workspace.vk.ru/*",
        "https://myteam.mail.ru/*",
        "https://*.myteam.mail.ru/*",
        "https://*.bizml.ru/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": [
        "modules/reaction-storage.js",
        "modules/all-emojis.js",
        "modules/connection-storage.js",
        "modules/sidebar-links-storage.js",
        "modules/appearance-storage.js",
        "modules/appearance-presets.js",
        "modules/appearance-applier.js",
        "modules/sidebar-settings.js",
        "ai-provider.js",
        "modules/call-recording/audio-mixer.js",
        "modules/call-recording/call-detector.js",
        "modules/call-recording/audio-recorder.js",
        "modules/call-recording/storage-manager.js",
        "modules/call-recording/audio-transcription.js",
        "modules/call-recording/call-recording-manager.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js",
        "connection.defaults.json",
        "connection.defaults.example.json",
        "icon48.png",
        "icon128.png",
        "icons/sidebar-reactions.svg",
        "ai-provider.js"
      ],
      "matches": [
        "https://app.workspace.vk.ru/*",
        "https://workspace.vk.ru/*",
        "https://*.workspace.vk.ru/*",
        "https://teams.your-organization.com/*",
        "https://*.teams.your-organization.com/*",
        "https://myteam.mail.ru/*",
        "https://*.myteam.mail.ru/*",
        "https://*.bizml.ru/*"
      ]
    }
  ]
}
